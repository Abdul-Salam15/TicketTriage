# Backend env for local development.
# Copy to `backend/.env` and fill in a real key:  cp .env.example .env

# Which provider to use: openai | anthropic | gemini
LLM_PROVIDER=openai

# Only the key matching LLM_PROVIDER is required.
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=your-key-here

# SQLite by default. Swap for Postgres in production:
# postgresql+psycopg://user:pass@localhost:5432/tickettriage
DATABASE_URL=sqlite:///./tickets.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Set to 1 ONLY to allow the destructive legacy-schema migration to drop tables.
ALLOW_DESTRUCTIVE_MIGRATION=0
